{
  "schema_version": 1,
  "scope": {
    "included": "Dedicated md_<model>.py production runners in this directory",
    "excluded": [
      "md_script-generic.py"
    ],
    "source_of_truth": "PEP 723 dependency blocks and model-construction calls in each script"
  },
  "version_policy": {
    "exact": "An == constraint is present in the runner or a concrete model version is passed to the loader.",
    "constrained": "The runner specifies a non-exact compatible range.",
    "indirect": "The package is installed through a torch-sim extra and is not directly pinned by the runner.",
    "runtime_resolved": "No concrete version is selected by the runner; the result can change when uv resolves the environment or a model registry default changes.",
    "warning": "This inventory records declared constraints, not a lockfile. Entries marked indirect or runtime_resolved are not exactly reproducible without recording the resolved uv environment."
  },
  "calculators": {
    "chgnet": {
      "script": "md_chgnet.py",
      "simulation_engine": "ase",
      "adapter": "chgnet.model.dynamics.CHGNetCalculator",
      "model": {
        "loader": "CHGNet.load(use_device='cuda:0')",
        "identifier": "package default pretrained checkpoint",
        "version": null,
        "version_status": "runtime_resolved"
      },
      "packages": {
        "chgnet": {
          "constraint": "==0.4.2",
          "status": "exact"
        },
        "ase": {
          "constraint": ">=3.26",
          "status": "constrained"
        },
        "torch-sim-atomistic": {
          "constraint": "==0.6.1",
          "status": "exact",
          "usage": "trajectory writer only"
        },
        "torch": {
          "constraint": null,
          "status": "runtime_resolved",
          "index": "pytorch-cu128"
        }
      }
    },
